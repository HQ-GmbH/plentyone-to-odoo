source ../config.sh
# Voraussetzung: PROMETHEUS_URL in ../config.sh, z. B. http://prometheus:9090.
set -euo pipefail
: "${PROMETHEUS_URL:?Set PROMETHEUS_URL in config.sh}"
curl -sS --fail-with-body -G "${PROMETHEUS_URL%/}/api/v1/query" --data-urlencode 'query=histogram_quantile(0.50, sum(rate(http_request_duration_seconds_bucket{job="odoo"}[5m])) by (le))'
